[Unit]
Description=mqvpn VPN Server
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/mp0rta/mqvpn
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# "+": the NAT script (iptables, sysctl) runs outside the capability bounding
# set below; iptables-legacy needs CAP_NET_RAW, which the server does not.
ExecStartPre=+@CMAKE_INSTALL_PREFIX@/lib/mqvpn/mqvpn-server-nat.sh setup /etc/mqvpn/server.conf
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/mqvpn --config /etc/mqvpn/server.conf
ExecStopPost=+@CMAKE_INSTALL_PREFIX@/lib/mqvpn/mqvpn-server-nat.sh teardown /etc/mqvpn/server.conf
Restart=on-failure
RestartSec=5

# Security hardening
# The server needs CAP_NET_ADMIN for its TUN device and SO_SNDBUFFORCE/
# SO_RCVBUFFORCE, and CAP_NET_BIND_SERVICE when Listen or the control API
# uses a port below 1024 (the example listens on 443).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Note: ProtectKernelTunables=yes is NOT set because the NAT script
# needs sysctl to enable IP forwarding.
ReadOnlyPaths=/etc/mqvpn
ReadWritePaths=/dev/net/tun
RuntimeDirectory=mqvpn

[Install]
WantedBy=multi-user.target
